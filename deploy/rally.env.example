# Modelo de homologacao local HTTPS. Nao habilita producao ou banco real.
NODE_ENV=development
HOST=127.0.0.1
PORT=3443
RALLY_SYNTHETIC_DIR=/var/lib/rally/synthetic
RALLY_DEV_DB_PATH=/var/lib/rally/synthetic/rally-dev.db
RALLY_TLS_CERT_PATH=/etc/rally/tls/server.crt
RALLY_TLS_KEY_PATH=/etc/rally/tls/server.key
