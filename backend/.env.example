PORT=3000
ADMIN_EMAIL=admin@rally.local
ADMIN_PASSWORD=
JWT_SECRET=
# Local: sem DATABASE_URL, usa SQLite.
# Render + Supabase: configure estas variáveis no painel, nunca no GitHub.
# DB_CLIENT=pg
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@HOST_POOLER:5432/postgres
# DB_SCHEMA=rally
# DATABASE_CA_CERT=certificado CA do provedor, se necessário (PEM)

# Origem pública HTTPS do Rally (sem caminho).
# APP_URL=https://seu-servico.onrender.com
# Login Google: configurar no Google Cloud; aprovação de cada vínculo pelo admin.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# E-mails são opcionais e exigem preferência de cada usuário.
NOTIFICATIONS_EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Rally das Tribos <rally@seu-dominio>

# Recomendado no Render Free: API HTTPS (remetente verificado).
# RESEND_API_KEY=
