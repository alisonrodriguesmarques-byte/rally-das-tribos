{
  "name": "rally-das-tribos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API e servidor do Rally das Tribos",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js --knexfile src/database/knexfile.js migrate:latest",
    "seed": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js --knexfile src/database/knexfile.js seed:run",
    "setup": "npm run migrate && npm run seed",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "better-sqlite3": "^12.4.1",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
